# Зависимости (ставятся через npm install, в репозиторий не нужны)
node_modules/

# Сборка и кэши
dist/
.vite/
**/.vite/

# Локальные сохранения мира и обучения (у каждого свои, в репо не нужны)
snapshot.json
snapshot.json.tmp
snapshot.json.bak
genome.json
genome-b.json
spider_genome.json
tmp/

# Godot & Blender
godot/.godot/
art/blender/*.blend1
*.tmp
*.mp4
*.webm
*.avi
!godot/recordings/*.mp4
!godot/recordings/**/*.mp4

# Логи и мусор
*.log
.DS_Store
Thumbs.db
__pycache__/
*.pyc

