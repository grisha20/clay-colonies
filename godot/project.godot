; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but for simple things you can edit it.

config_version=5

[application]

config/name="Clayfolk"
config/description="3D Clay Colony Simulation"
run/main_scene="res://scenes/game/world_observer.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=false
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=4096
environment/defaults/default_clear_color=Color(0.2, 0.22, 0.25, 1)
