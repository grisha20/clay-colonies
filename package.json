{
  "name": "ant-colony-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "check": "npm run check -w server && npm run check -w client",
    "reset": "node -e \"require('node:fs').rmSync('snapshot.json',{force:true})\"",
    "stats:snapshot": "tsx server/src/bench/snapshotStats.ts",
    "bench:server": "tsx server/src/bench/serverStep.ts",
    "check:slice": "tsx server/src/bench/sliceCheck.ts",
    "check:gameplay": "tsx server/src/bench/gameplayCheck.ts",
    "check:motion": "tsx server/src/bench/motionCheck.ts",
    "check:world": "tsx server/src/bench/worldCheck.ts",
    "check:deposits": "tsx server/src/bench/depositsCheck.ts",
    "check:grounding": "tsx server/src/bench/groundingCheck.ts",
    "check:fences": "tsx server/src/bench/fenceCheck.ts",
    "check:navigation": "tsx server/src/bench/navigationCheck.ts",
    "check:jitter": "tsx server/src/bench/jitterCheck.ts",
    "check:terrain": "tsx server/src/bench/terrainCheck.ts",
    "check:mother": "tsx server/src/bench/motherCheck.ts",
    "check:navparity": "tsx server/src/bench/navParityCheck.ts",
    "bench:crowd": "tsx server/src/bench/crowdBench.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
